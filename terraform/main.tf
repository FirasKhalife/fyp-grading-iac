data "aws_caller_identity" "current" {}

data "aws_partition" "current" {}

# Always the current Amazon Linux 2023 AMI, resolved from the public SSM parameter at plan time.
data "aws_ssm_parameter" "ami" {
  name = var.ami_ssm_parameter
}

module "vpc" {
  source = "./modules/vpc"

  name                 = local.name
  cidr                 = var.vpc_cidr
  az_count             = var.az_count
  enable_nat_gateway   = var.enable_nat_gateway
  flow_log_kms_key_arn = aws_kms_key.main.arn
}

# ---------------------------------------------------------------- encryption key

# Key policies always use Resource "*": it means "this key" and nothing else.
data "aws_iam_policy_document" "kms" {
  #checkov:skip=CKV_AWS_109:key policy resource is implicitly this key
  #checkov:skip=CKV_AWS_111:key policy resource is implicitly this key
  #checkov:skip=CKV_AWS_356:key policy resource is implicitly this key
  statement {
    sid       = "AccountAdmin"
    actions   = ["kms:*"]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = ["arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:root"]
    }
  }

  statement {
    sid       = "AllowCloudWatchLogs"
    actions   = ["kms:Encrypt*", "kms:Decrypt*", "kms:ReEncrypt*", "kms:GenerateDataKey*", "kms:Describe*"]
    resources = ["*"]
    principals {
      type        = "Service"
      identifiers = ["logs.${var.region}.amazonaws.com"]
    }
  }
}

resource "aws_kms_key" "main" {
  description             = "${local.name}: EBS volumes, SSM SecureString parameters, flow logs"
  enable_key_rotation     = true
  deletion_window_in_days = 7
  policy                  = data.aws_iam_policy_document.kms.json
}

resource "aws_kms_alias" "main" {
  name          = "alias/${local.name}"
  target_key_id = aws_kms_key.main.key_id
}

# ---------------------------------------------------------------- secrets

# Generated by OpenTofu and stored only in SSM (and in state, which is encrypted in S3).
resource "random_password" "secret" {
  for_each = local.secret_names

  length  = 32
  special = false # keeps the values safe to embed in JDBC / Mongo URIs
}

resource "aws_ssm_parameter" "secret" {
  for_each = local.secret_names

  name   = "${local.ssm_path}/${each.key}"
  type   = "SecureString"
  value  = random_password.secret[each.key].result
  key_id = aws_kms_key.main.arn
}

# ---------------------------------------------------------------- instance access

data "aws_iam_policy_document" "assume_ec2" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ec2.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "app" {
  name               = "${local.name}-app"
  assume_role_policy = data.aws_iam_policy_document.assume_ec2.json
}

# Session Manager replaces SSH: no key pair, no port 22, no bastion.
resource "aws_iam_role_policy_attachment" "ssm_core" {
  role       = aws_iam_role.app.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

data "aws_iam_policy_document" "read_secrets" {
  statement {
    sid       = "ReadOwnParameters"
    actions   = ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"]
    resources = ["arn:${data.aws_partition.current.partition}:ssm:${var.region}:${data.aws_caller_identity.current.account_id}:parameter${local.ssm_path}/*"]
  }

  statement {
    sid       = "DecryptWithProjectKey"
    actions   = ["kms:Decrypt"]
    resources = [aws_kms_key.main.arn]
  }
}

resource "aws_iam_role_policy" "read_secrets" {
  name   = "read-secrets"
  role   = aws_iam_role.app.id
  policy = data.aws_iam_policy_document.read_secrets.json
}

resource "aws_iam_instance_profile" "app" {
  name = "${local.name}-app"
  role = aws_iam_role.app.name
}

# ---------------------------------------------------------------- network rules

resource "aws_security_group" "app" {
  name        = "${local.name}-app"
  description = "App host: no inbound at all, outbound HTTPS only"
  vpc_id      = module.vpc.vpc_id
}

resource "aws_vpc_security_group_egress_rule" "https" {
  security_group_id = aws_security_group.app.id
  description       = "HTTPS out: SSM, package repos, container registries, Git"
  ip_protocol       = "tcp"
  from_port         = 443
  to_port           = 443
  cidr_ipv4         = "0.0.0.0/0"
}

# ---------------------------------------------------------------- the instance

resource "aws_instance" "app" {
  ami                    = data.aws_ssm_parameter.ami.value
  instance_type          = var.instance_type
  subnet_id              = module.vpc.private_subnet_ids[0]
  vpc_security_group_ids = [aws_security_group.app.id]
  iam_instance_profile   = aws_iam_instance_profile.app.name

  associate_public_ip_address = false
  ebs_optimized               = true
  monitoring                  = true

  metadata_options {
    http_endpoint               = "enabled"
    http_tokens                 = "required" # IMDSv2 only
    http_put_response_hop_limit = 1          # containers cannot reach the metadata service
  }

  root_block_device {
    volume_type           = "gp3"
    volume_size           = var.root_volume_size_gb
    encrypted             = true
    kms_key_id            = aws_kms_key.main.arn
    delete_on_termination = true
  }

  # Contains no secrets: the script fetches them from SSM at boot using the instance role.
  user_data = templatefile("${path.module}/templates/user_data.sh.tftpl", {
    region           = var.region
    ssm_path         = local.ssm_path
    compose_repo_url = var.compose_repo_url
  })
  user_data_replace_on_change = true

  tags = {
    Name = "${local.name}-app"
  }

  lifecycle {
    ignore_changes = [ami] # a new AMI release must not silently replace the host
  }
}
