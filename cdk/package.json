{
  "name": "fyp-grading-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK reference deployment of the FYP grading platform (synthesized and tested, never deployed)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "check": "npm run build && npm run lint && npm test && npm run synth"
  },
  "dependencies": {
    "aws-cdk-lib": "2.277.0",
    "cdk-nag": "2.38.2",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "aws-cdk": "2.1148.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
