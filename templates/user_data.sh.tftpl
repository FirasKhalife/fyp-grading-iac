#!/bin/bash
# Boot script for the FYP grading host. Rendered by OpenTofu; contains no secrets.
set -euo pipefail

dnf install -y docker git
systemctl enable --now docker

# Compose v2 plugin
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

git clone --depth 1 "${compose_repo_url}" /opt/fyp

# Pull secrets from SSM Parameter Store into a root-only env file (instance-role credentials via IMDSv2).
umask 077
: > /opt/fyp/.env
for name in postgres_password mongo_password rabbitmq_password keycloak_admin_password; do
  value="$(aws ssm get-parameter --region "${region}" --with-decryption \
    --name "${ssm_path}/$name" --query Parameter.Value --output text)"
  echo "$(echo "$name" | tr '[:lower:]' '[:upper:]')=$value" >> /opt/fyp/.env
done

cat > /etc/systemd/system/fyp.service <<'UNIT'
[Unit]
Description=FYP grading platform (docker compose)
After=docker.service network-online.target
Requires=docker.service

[Service]
WorkingDirectory=/opt/fyp
ExecStart=/usr/bin/docker compose --env-file /opt/fyp/.env up
ExecStop=/usr/bin/docker compose down
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now fyp.service
