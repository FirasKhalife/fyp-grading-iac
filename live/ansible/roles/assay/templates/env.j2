# Created by Ansible (fyp-grading-iac/live) on the first deploy, then never regenerated: the databases were
# initialised with these passwords. Keys and meaning: docker-compose/prod/.env.example. Never copy it into git.
# Ansible keeps PUBLIC_URL, ASSAY_TAG and TUNNEL_TOKEN in line on every run.
PUBLIC_URL={{ assay_public_url }}
ASSAY_TAG={{ assay_image_tag }}

DB_USER=assay
DB_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}

RABBITMQ_USER=assay
RABBITMQ_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}

REDIS_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}

# The first start creates this master admin; keycloak-rotate-admin.sh then replaces it with a permanent one and
# rewrites these two lines.
KEYCLOAK_ADMIN_USER={{ assay_keycloak_bootstrap_admin }}
KEYCLOAK_ADMIN_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=32, chars=['ascii_letters', 'digits']) }}

TUNNEL_TOKEN={{ assay_tunnel_token }}

EDGE_PORT=8080
